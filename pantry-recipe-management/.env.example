# Public server
PORT=3000
VITE_APP_ID=
OAUTH_SERVER_URL=
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=mysql://user:password@host:3306/pantry

# Existing Manus/OpenAI-compatible provider (optional fallback)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Gemini is preferred when configured. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
