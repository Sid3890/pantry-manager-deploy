# Public server
PORT=3000

# Google OAuth 2.0 web application credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Session signing and database
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=mysql://user:password@host:3306/pantry

# Existing Manus/OpenAI-compatible provider (optional fallback)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Gemini is optional and used only to select/validate retrieved recipes.
# It must never be committed to this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
